{
  "name": "ed-api",
  "version": "1.0.0",
  "type": "module",
  "repository": "https://github.com/EuphoriaTheme/backend.git",
  "author": "Rep Graphics <support@euphoriadevelopment.uk>",
  "contributors": [
    "KingIronMan2011 <IronMan@king-mc.de> (https://kingironman.dev)"
  ],
  "license": "MIT",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "tsc && node -e \"require('node:fs').cpSync('public', 'dist/public', { recursive: true })\"",
    "start": "node dist/server.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "types": "tsc --noEmit",
    "update:games": "tsx ./scripts/updateGamesYml.ts",
    "fetch:gameicons": "tsx ./scripts/fetchGameIcons.ts",
    "sync:translations": "tsx ./scripts/syncTranslations.ts",
    "sync:blueprint": "tsx ./scripts/syncBlueprintExtensions.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "axios": "^1.20.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1",
    "gamedig": "^5.3.3",
    "js-yaml": "^5.4.1",
    "rcon-client": "^4.2.5",
    "rcon-srcds": "^2.1.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "eslint": "^10.9.1",
    "globals": "^17.12.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0"
  }
}
